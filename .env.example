# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
INSIGHTLY_LLM_PROVIDER=openai          # openai | offline (no-LLM baseline, free)

# Models (change here, then re-run `insightly eval run` before shipping)
INSIGHTLY_MODEL_ROUTER=gpt-5.4-nano
INSIGHTLY_MODEL_SQL=gpt-5.4-mini
INSIGHTLY_MODEL_SQL_STRONG=gpt-5.4
INSIGHTLY_MODEL_ANSWER=gpt-5.4-nano
INSIGHTLY_EMBEDDING_MODEL=text-embedding-3-small
INSIGHTLY_REASONING_EFFORT=low

# Cost guardrails
INSIGHTLY_REQUEST_BUDGET_USD=0.05
INSIGHTLY_DAILY_BUDGET_USD=5

# Local engine (DuckDB over data/curated). For Athena set:
INSIGHTLY_QUERY_ENGINE=duckdb
# INSIGHTLY_QUERY_ENGINE=athena
# AWS_REGION=ap-south-1
# INSIGHTLY_ATHENA_WORKGROUP=insightly
# INSIGHTLY_ATHENA_DATABASE=insightly_curated
# INSIGHTLY_DATA_BUCKET=insightly-data-<account>-<region>

# Optional: LangSmith tracing + experiments
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=insightly

# Behind a corporate proxy, let langchain-openai honour HTTPS_PROXY:
# LANGCHAIN_OPENAI_TCP_KEEPALIVE=0
